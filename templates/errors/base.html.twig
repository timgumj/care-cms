{% set code=status_code|default(500) %}{% set english=error_english is defined ? error_english : ((app.request.pathInfo starts with '/en/') or (app.request.locale starts with 'en')) %}{% set home=english ? '/en/' : '/' %}<!doctype html><html lang="{{ english ? 'en' : 'de' }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{ code }} · Care CMS</title><link rel="stylesheet" href="/assets/mint-theme.css?v=1"></head><body class="pack-practice"><header class="pack-header pack-practice"><a class="pack-brand" href="{{ home }}">Praxis Morgen</a><a href="{{ home }}">{{ english ? 'Home' : 'Startseite' }}</a></header><main class="mint-error"><p class="mint-kicker">{{ english ? 'A little off the usual path' : 'Ein wenig abseits des Weges' }}</p><h1>{{ code }}</h1><h2>{{ code==404 ? (english ? 'This page could not be found.' : 'Diese Seite wurde nicht gefunden.') : (english ? 'This page is unavailable.' : 'Diese Seite ist nicht verfügbar.') }}</h2><p>{{ english ? 'Check the address or return to the practice homepage.' : 'Prüfen Sie die Adresse oder kehren Sie zur Startseite zurück.' }}</p><a class="pack-button" href="{{ home }}">{{ english ? 'Back to the homepage' : 'Zur Startseite' }}</a></main><footer class="mint-titlebar"><p>Care CMS · {{ english ? 'Fictional portfolio demonstration' : 'Fiktive Portfolio-Demonstration' }}</p></footer></body></html>