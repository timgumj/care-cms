{% set code = status_code|default(500) %}
{% set english = error_english is defined ? error_english : ((app.request.pathInfo starts with '/en/') or (app.request.locale starts with 'en')) %}
{% set home = english ? '/en/' : '/' %}
<!doctype html><html lang="{{ english ? 'en' : 'de' }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow">
<title>{{ code }} · {{ english ? 'Care Studio — Urology' : 'Care Studio — Urologie' }}</title><link rel="stylesheet" href="/assets/error-pages.css?v=12"><link rel="stylesheet" href="/assets/demo.css?v=12"><link rel="stylesheet" href="/assets/admin-bar.css?v=12"></head>
<body>{% include 'site/_admin_bar.html.twig' %}<header><a class="brand" href="{{ home }}">Care Studio<span>{{ english ? 'Fictional practice' : 'Fiktive Praxis' }}</span></a><nav aria-label="{{ english ? 'Language' : 'Sprache' }}"><a href="/" lang="de">Deutsch</a><a href="/en/" lang="en">English</a></nav></header>
<main><div class="error-code" aria-hidden="true">{{ code }}</div>
{% if code == 404 %}<h1>{{ english ? 'Page not found' : 'Seite nicht gefunden' }}</h1><p>{{ english ? 'The page you are looking for does not exist or has moved. Please check the address or return to the homepage.' : 'Die gewünschte Seite existiert nicht oder wurde verschoben. Bitte prüfen Sie die Adresse oder kehren Sie zur Startseite zurück.' }}</p>
{% elseif code == 403 %}<h1>{{ english ? 'Access unavailable' : 'Zugriff nicht möglich' }}</h1><p>{{ english ? 'You do not have permission to open this page.' : 'Sie haben keine Berechtigung, diese Seite zu öffnen.' }}</p>
{% else %}<h1>{{ english ? 'Temporarily unavailable' : 'Vorübergehend nicht verfügbar' }}</h1><p>{{ english ? 'We could not load this page. Please try again later.' : 'Diese Seite konnte nicht geladen werden. Bitte versuchen Sie es später erneut.' }}</p>{% endif %}
<div class="error-actions"><a class="primary" href="{{ home }}">{{ english ? 'Back to homepage' : 'Zur Startseite' }}</a><a href="/booking/">{{ english ? 'Contact the practice' : 'Ordination kontaktieren' }}</a></div></main>
<footer><span>Care Studio</span></footer></body></html>
