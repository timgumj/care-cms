{% extends 'admin/auth_base.html.twig' %}{% block title %}Care Studio · Calendar{% endblock %}{% block extra_head %}<link rel="stylesheet" href="/assets/demo.css?v=12">{% endblock %}{% block content %}<section class="calendar-admin"><p><a href="{{ path('admin') }}">← Dashboard</a></p><h1>Calendar / Terminübersicht</h1><p>{{ timezone }} · Fictional demo appointments only. Administrator access required.</p>{% if error %}<p role="alert">{{ error }}</p>{% endif %}<nav class="month-nav"><a href="?month={{ previous }}">← Previous</a><strong>{{ month }}</strong><a href="?month={{ next }}">Next →</a></nav><div class="calendar-grid">{% for day in ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'] %}<strong>{{ day }}</strong>{% endfor %}{% for i in 1..offset %}{% if offset>0 %}<div></div>{% endif %}{% endfor %}{% for day in days %}<div class="calendar-day"><strong>{{ day|slice(-2) }}</strong>{% for item in by_day[day]|default([]) %}<p class="calendar-event {{ item.status }}">{{ item.local|date('H:i',timezone) }} · {{ item.attendee_name }}<br><small>{{ item.status }}</small></p>{% endfor %}</div>{% endfor %}</div><h2>Appointments / Termine</h2><div class="table-scroll"><table><thead><tr><th>Time</th><th>Name</th><th>Email</th><th>Status</th><th>Action</th></tr></thead><tbody>{% for item in rows %}<tr><td>{{ item.starts_at|date('d M H:i',timezone) }}</td><td>{{ item.attendee_name }}</td><td>{{ item.email }}</td><td>{{ item.status }}</td><td>{% if item.status=='confirmed' %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('calendar') }}"><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="{{ item.id }}"><label><input type="checkbox" required> Confirm cancellation</label><button>Cancel</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5">No demo appointments this month.</td></tr>{% endfor %}</tbody></table></div><h2>Availability / Verfügbarkeit</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('calendar') }}"><input type="hidden" name="action" value="availability"><fieldset><legend>Working days</legend>{% for day,label in {1:'Mon',2:'Tue',3:'Wed',4:'Thu',5:'Fri',6:'Sat',7:'Sun'} %}<label class="check"><input type="checkbox" name="days[]" value="{{ day }}"{% if day in settings.days %} checked{% endif %}>{{ label }}</label>{% endfor %}</fieldset><label>Opens<input type="time" name="opens" value="{{ settings.opens }}" required></label><label>Closes<input type="time" name="closes" value="{{ settings.closes }}" required></label><label>Blocked dates (YYYY-MM-DD, one per line)<textarea name="blocked" rows="4">{{ settings.blocked|join('
') }}</textarea></label><button>Save availability</button></form></section>{% endblock %}