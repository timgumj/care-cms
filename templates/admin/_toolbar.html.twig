{% set en = app.request.locale starts with 'en' %}
<nav class="cms-toolbar" aria-label="{{ en ? 'Website administration' : 'Website-Verwaltung' }}">
<div class="cms-toolbar-left">
<a class="cms-toolbar-brand" href="{{ path('admin') }}"><span class="cms-mark" aria-hidden="true">C</span><span>Care Studio</span></a>
<a href="{{ backend|default(false) ? '/en/' : path('admin') }}"{% if backend|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{% include 'admin/_icon.html.twig' with {name: backend|default(false) ? 'arrow-up-right' : 'workspace'} %}<span>{{ backend|default(false) ? (en ? 'Visit site' : 'Website ansehen') : (en ? 'Dashboard' : 'Übersicht') }}</span></a>
<details class="cms-toolbar-dropdown"><summary>{% include 'admin/_icon.html.twig' with {name:'plus'} %}{{ en ? 'New' : 'Neu' }}<span class="cms-chevron" aria-hidden="true">⌄</span></summary><div class="cms-toolbar-dropdown-panel"><a href="{{ path('admin_content_link',{kind:'pages',action:'new'}) }}">{{ en ? 'Page' : 'Seite' }}</a><a href="{{ path('admin_content_link',{kind:'articles',action:'new'}) }}">{{ en ? 'Article' : 'Artikel' }}</a><a href="{{ path('admin_media') }}">{{ en ? 'Media' : 'Medien' }}</a></div></details>
{% if not backend|default(false) and app.request.attributes.get('_route') == 'site_page' and page is defined and page.id %}<a class="cms-toolbar-edit" href="{{ path('admin_edit_page',{id:page.id}) }}">{% include 'admin/_icon.html.twig' with {name:'edit'} %}<span>{{ en ? 'Edit page' : 'Seite bearbeiten' }}</span></a>{% endif %}
{% if is_granted('ROLE_ADMIN') %}<a class="cms-toolbar-secondary" href="{{ path('admin_calendar') }}">{% include 'admin/_icon.html.twig' with {name:'calendar'} %}<span>{{ en ? 'Calendar' : 'Kalender' }}</span></a><a class="cms-toolbar-secondary" href="{{ path('admin_cache') }}">{% include 'admin/_icon.html.twig' with {name:'refresh'} %}<span>{{ en ? 'Cache' : 'Cache' }}</span></a>{% endif %}
</div><div class="cms-toolbar-right">
{% if backend|default(false) %}<div class="cms-toolbar-languages"><a href="{{ app.request.pathInfo }}?{{ app.request.query.all|merge({'_locale':'de'})|url_encode }}" lang="de"{% if not en %} aria-current="true"{% endif %}>DE</a><a href="{{ app.request.pathInfo }}?{{ app.request.query.all|merge({'_locale':'en'})|url_encode }}" lang="en"{% if en %} aria-current="true"{% endif %}>EN</a></div>{% endif %}
<details class="cms-toolbar-dropdown cms-account"><summary><span class="cms-account-name">{{ app.user.displayName ?: app.user.email }}</span><span class="cms-avatar" aria-hidden="true">{{ (app.user.displayName ?: app.user.email)|slice(0,1)|upper }}</span></summary><div class="cms-toolbar-dropdown-panel"><span class="cms-account-role">{{ is_granted('ROLE_ADMIN') ? (en ? 'Administrator' : 'Administrator') : (en ? 'Editor' : 'Redaktion') }}</span>{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_users') }}">{{ en ? 'Manage users' : 'Benutzer verwalten' }}</a>{% endif %}<a href="{{ path('app_logout_confirm') }}">{{ en ? 'Sign out' : 'Abmelden' }}</a></div></details>
</div></nav>