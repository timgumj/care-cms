{% extends 'admin/auth_base.html.twig' %}{% block title %}Starter packs · Care CMS{% endblock %}{% block content %}{% set en=app.request.locale starts with 'en' %}<section class="starter-admin"><div class="cms-page-intro"><div><h1>{{ en ? 'Starter packs' : 'Starter-Vorlagen' }}</h1><p>{{ en ? 'Choose a starting point. Make it your own.' : 'Wählen Sie einen Ausgangspunkt und gestalten Sie Ihre Website.' }}</p></div><span class="cms-small-label">4 {{ en ? 'designs' : 'Designs' }} · DE / EN</span></div>{% if error %}<p class="notice" role="alert">{{ error }}</p>{% endif %}{% for message in app.flashes('success') %}<p class="notice">{{ message }}</p>{% endfor %}<div class="starter-gallery">{% for key,pack in packs %}<article class="starter-card"><a class="starter-thumbnail" aria-label="{{ pack.name }} {{ en ? 'preview' : 'Vorschau' }}" href="{{ path('admin_starter_preview',{key:key}) }}" target="_blank" rel="noopener noreferrer"><iframe src="{{ path('admin_starter_preview',{key:key}) }}?lang=en" title="{{ pack.name }} {{ en ? 'design preview' : 'Design-Vorschau' }}" loading="lazy" tabindex="-1" aria-hidden="true"></iframe></a><div class="starter-card-content"><div><h2>{{ pack.name }}</h2><p>{{ pack.subtitle }}</p></div><a class="starter-preview-link" href="{{ path('admin_starter_preview',{key:key}) }}" target="_blank" rel="noopener noreferrer">{{ en ? 'Preview ↗' : 'Vorschau ↗' }}</a></div><form method="post" class="starter-create"><input type="hidden" name="_token" value="{{ csrf_token('starter_packs') }}"><input type="hidden" name="action" value="create"><input type="hidden" name="pack" value="{{ key }}"><label for="name-{{ key }}">{{ en ? 'Practice / website name' : 'Praxis- / Website-Name' }}</label><div><input id="name-{{ key }}" name="name" value="{{ pack.brand }}" minlength="2" maxlength="100" required><button type="submit">{{ en ? 'Use starter' : 'Vorlage nutzen' }}</button></div></form></article>{% endfor %}</div><p class="cms-help-note">{{ en ? 'Creates eight editable draft pages, with booking links and language pairs. Existing pages, accounts and appointments are preserved. All content and imagery is fictional.' : 'Erstellt acht bearbeitbare Entwürfe mit Terminlinks und Sprachpaaren. Bestehende Seiten, Konten und Termine bleiben erhalten. Alle Inhalte und Abbildungen sind fiktiv.' }}</p><h2>{{ en ? 'Your starter sites' : 'Ihre Vorlagen-Websites' }}</h2><div class="cms-table-scroll"><table class="cms-content-table"><thead><tr><th>{{ en ? 'Website' : 'Website' }}</th><th>Design</th><th>Status</th><th></th></tr></thead><tbody>{% for site in sites %}<tr><td><a href="{{ path('admin_starter_site',{id:site.id}) }}">{{ site.name }}</a></td><td>{{ packs[site.pack_key].name }}</td><td>{{ site.active ? (en ? 'Active website' : 'Aktive Website') : (en ? 'Saved starter' : 'Gespeicherte Vorlage') }}</td><td><a href="{{ path('admin_starter_site',{id:site.id}) }}">{{ en ? 'Open →' : 'Öffnen →' }}</a></td></tr>{% else %}<tr><td colspan="4">{{ en ? 'No starter sites yet. Choose a design above.' : 'Noch keine Vorlagen-Websites. Wählen Sie oben ein Design.' }}</td></tr>{% endfor %}</tbody></table></div>{% if sites|filter(site=>site.active)|length %}<form method="post" class="starter-restore"><input type="hidden" name="_token" value="{{ csrf_token('starter_packs') }}"><input type="hidden" name="action" value="deactivate"><label class="cms-check"><input type="checkbox" name="confirm" value="yes" required>{{ en ? 'Switch back to the original Care Studio demo. Keep all starter pages.' : 'Zur ursprünglichen Care-Studio-Demo zurückkehren. Alle Vorlagenseiten behalten.' }}</label><button>{{ en ? 'Restore original demo' : 'Ursprüngliche Demo wiederherstellen' }}</button></form>{% endif %}</section>{% endblock %}