<section class="menu-item" data-menu-item>
<div class="menu-item-bar"><button type="button" class="menu-drag" draggable="true" data-menu-drag aria-label="{{ 'Drag to reorder'|trans }}"><svg width="16" height="20" viewBox="0 0 16 20" fill="currentColor" aria-hidden="true"><path d="M4 3h2v2H4zm6 0h2v2h-2zM4 9h2v2H4zm6 0h2v2h-2zM4 15h2v2H4zm6 0h2v2h-2z"/></svg></button><span>{{ 'Menu item'|trans }}</span><div class="menu-item-actions"><button type="button" data-menu-up aria-label="{{ 'Move up'|trans }}">↑</button><button type="button" data-menu-down aria-label="{{ 'Move down'|trans }}">↓</button><button type="button" data-menu-remove>{{ 'Remove from menu'|trans }}</button></div></div>
<div class="menu-item-fields"><div><label for="menu_{{ index }}_title">{{ 'Navigation label'|trans }}</label><input id="menu_{{ index }}_title" name="items[{{ index }}][title]" value="{{ item.title }}" maxlength="100" required data-menu-title></div>
<div><label for="menu_{{ index }}_type">{{ 'Link type'|trans }}</label><select id="menu_{{ index }}_type" name="items[{{ index }}][type]" data-menu-type><option value="page"{% if item.type=='page' %} selected{% endif %}>{{ 'Page or article'|trans }}</option><option value="custom"{% if item.type=='custom' %} selected{% endif %}>{{ 'Custom link'|trans }}</option></select></div>
<div class="menu-item-destination" data-menu-page><label for="menu_{{ index }}_page_path">{{ 'Page or article'|trans }}</label><select id="menu_{{ index }}_page_path" name="items[{{ index }}][page_path]" data-menu-page-select><option value="">{{ 'Choose content'|trans }}</option>{% for page in pages %}<option value="{{ page.path }}" data-page-title="{{ page.title }}"{% if item.type=='page' and item.url==page.path %} selected{% endif %}>{{ page.title }} · {{ page.path }}{% if not page.published %} ({{ 'Entwurf'|trans }}){% endif %}</option>{% endfor %}</select></div>
<div class="menu-item-destination" data-menu-custom><label for="menu_{{ index }}_custom_url">{{ 'Custom URL'|trans }}</label><input id="menu_{{ index }}_custom_url" name="items[{{ index }}][custom_url]" value="{{ item.type=='custom' ? item.url : '' }}" maxlength="2048" placeholder="/contact/ or https://example.com/"></div>
<label class="menu-checkbox"><input type="checkbox" name="items[{{ index }}][new_tab]" value="1"{% if item.new_tab %} checked{% endif %}>{{ 'Open in a new tab'|trans }}</label><label class="menu-checkbox"><input type="checkbox" name="items[{{ index }}][button]" value="1"{% if item.button %} checked{% endif %}>{{ 'Display as a button'|trans }}</label></div>
</section>
