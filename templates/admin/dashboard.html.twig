{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}{{ app.request.locale starts with 'en' ? 'Overview' : 'Übersicht' }}{% endblock %}
{% block main %}
{% set en = app.request.locale starts with 'en' %}
<div class="cms-dashboard">
<div class="cms-overview-heading"><p>{{ en ? 'Manage your website, content and practice.' : 'Website, Inhalte und Praxis verwalten.' }}</p><div><a class="cms-outline-button" href="/en/" target="_blank" rel="noopener noreferrer">{{ en ? 'Visit site ↗' : 'Website ansehen ↗' }}</a><a class="cms-solid-button" href="{{ path('admin_content_link',{kind:'pages',action:'new'}) }}">+ {{ en ? 'New page' : 'Neue Seite' }}</a></div></div>
<div class="cms-overview-stats"><div><span>{{ en ? 'Pages' : 'Seiten' }}</span><strong>{{ page_count }}</strong><small>{{ en ? 'Website pages' : 'Website-Seiten' }}</small></div><div><span>{{ en ? 'Articles' : 'Artikel' }}</span><strong>{{ post_count }}</strong><small>{{ en ? 'Journal entries' : 'Journal-Beiträge' }}</small></div><div><span>{{ en ? 'Published' : 'Veröffentlicht' }}</span><strong>{{ published_pages }}</strong><small>{{ en ? 'Content items online' : 'Inhalte online' }}</small></div><div><span>{{ en ? 'Drafts' : 'Entwürfe' }}</span><strong>{{ draft_count }}</strong><small>{{ en ? 'Not yet published' : 'Noch nicht veröffentlicht' }}</small></div></div>
<div class="cms-dashboard-grid"><div class="cms-dashboard-column">
<section class="cms-panel"><header><h3>{{ en ? 'Recent content' : 'Zuletzt bearbeitet' }}</h3><a href="{{ path('admin_content_link',{kind:'pages',action:'index'}) }}">{{ en ? 'View all pages' : 'Alle Seiten' }}</a></header><div class="cms-table-scroll"><table class="cms-content-table"><thead><tr><th>{{ en ? 'Title' : 'Titel' }}</th><th>{{ en ? 'Language' : 'Sprache' }}</th><th>{{ en ? 'Status' : 'Status' }}</th><th>{{ en ? 'Updated' : 'Aktualisiert' }}</th></tr></thead><tbody>{% for page in recent_pages %}<tr><td><a href="{{ path('admin_edit_page',{id:page.id}) }}">{{ page.title }}</a><small>{{ page.path }}</small></td><td><span class="cms-locale-tag">{{ page.locale starts with 'en' ? 'EN' : 'DE' }}</span></td><td><span class="cms-content-state">{{ page.published ? (en ? 'Published' : 'Veröffentlicht') : (en ? 'Draft' : 'Entwurf') }}</span></td><td>{{ page.updatedAt|date('d M Y') }}</td></tr>{% else %}<tr><td colspan="4">{{ en ? 'No content yet. Add your first page.' : 'Noch keine Inhalte vorhanden.' }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="cms-panel"><header><h3>{{ en ? 'Languages & publishing' : 'Sprachen & Veröffentlichung' }}</h3>{% include 'admin/_icon.html.twig' with {name:'globe'} %}</header><div class="cms-panel-body cms-language-overview"><div><span>DE</span><strong>{{ german_pages }}</strong><small>{{ en ? 'German content items' : 'Deutsche Inhalte' }}</small></div><div><span>EN</span><strong>{{ english_pages }}</strong><small>{{ en ? 'English content items' : 'Englische Inhalte' }}</small></div></div><footer>{{ en ? 'Translations are linked, with independent editing and publication.' : 'Übersetzungen sind verbunden und lassen sich unabhängig bearbeiten.' }}</footer></section>
</div><div class="cms-dashboard-column">
<section class="cms-panel"><header><h3>{{ en ? 'Website' : 'Website' }}</h3>{% include 'admin/_icon.html.twig' with {name:'desktop'} %}</header><div class="cms-site-summary"><div><span>{{ en ? 'Design' : 'Design' }}</span><a href="{{ path('admin_starters') }}">{{ active_starter ? active_starter.pack_key|capitalize : 'Care Studio' }}</a></div><div><span>{{ en ? 'Imported fonts' : 'Importierte Schriften' }}</span><strong>{{ font_count }}</strong></div><div><span>{{ en ? 'Languages' : 'Sprachen' }}</span><strong>DE / EN</strong></div></div></section>
{% if is_granted('ROLE_ADMIN') %}<section class="cms-panel"><header><h3>{{ en ? 'Upcoming appointments' : 'Nächste Termine' }}</h3><span class="cms-count">{{ booking_count }}</span></header><div class="cms-panel-body">{% for booking in next_bookings %}<div class="cms-next-booking"><strong>{{ booking.starts_at|date('d M · H:i') }}</strong><span>{{ booking.appointment_type == 'consultation' ? (en ? 'Consultation' : 'Beratung') : (en ? 'Follow-up' : 'Folgetermin') }}</span></div>{% else %}<p class="cms-empty-note">{{ en ? 'No upcoming appointments. Confirmed demo bookings will appear here.' : 'Keine anstehenden Termine. Bestätigte Demo-Buchungen erscheinen hier.' }}</p>{% endfor %}<a class="cms-panel-link" href="{{ path('admin_calendar') }}">{{ en ? 'Open calendar →' : 'Kalender öffnen →' }}</a></div></section>{% endif %}
<section class="cms-panel"><header><h3>{{ en ? 'Quick links' : 'Direktzugriff' }}</h3>{% include 'admin/_icon.html.twig' with {name:'link'} %}</header><div class="cms-quick-links"><a href="{{ path('admin_media') }}">{{ en ? 'Manage images' : 'Bilder verwalten' }}<span>→</span></a>{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_starters') }}">{{ en ? 'Choose a starter pack' : 'Starter-Vorlage wählen' }}<span>→</span></a><a href="{{ path('admin_fonts') }}">{{ en ? 'Manage fonts' : 'Schriften verwalten' }}<span>→</span></a><a href="{{ path('admin_menus') }}">{{ en ? 'Edit navigation menus' : 'Menüs bearbeiten' }}<span>→</span></a><a href="{{ path('admin_users') }}">{{ en ? 'Manage user access' : 'Benutzer verwalten' }}<span>→</span></a>{% endif %}<a href="/api/v1/pages?locale=en-AT" target="_blank" rel="noopener noreferrer">{{ en ? 'View content API' : 'Inhalts-API ansehen' }}<span>↗</span></a></div></section>
</div></div><footer class="cms-workspace-footer">Care CMS <span>{{ en ? 'Independent content management · Portfolio demo' : 'Unabhängige Inhaltsverwaltung · Portfolio-Demo' }}</span></footer>
</div>{% endblock %}
