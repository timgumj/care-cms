{% extends 'admin/auth_base.html.twig' %}{% block title %}Fonts · Care CMS{% endblock %}{% block content %}{% set en=app.request.locale starts with 'en' %}<section class="font-admin"><div class="cms-page-intro"><div><h1>{{ en ? 'Fonts' : 'Schriften' }}</h1><p>{{ en ? 'Your typography, hosted with your website.' : 'Ihre Typografie, lokal mit Ihrer Website gehostet.' }}</p></div><span class="cms-small-label">WOFF2 · {{ fonts|length }} / 20</span></div>{% if error %}<p role="alert" class="notice">{{ error }}</p>{% endif %}{% for message in app.flashes('success') %}<p class="notice">{{ message }}</p>{% endfor %}<form method="post" class="font-selection"><h2>{{ en ? 'Website typography' : 'Website-Typografie' }}</h2><input type="hidden" name="_token" value="{{ csrf_token('fonts') }}"><input type="hidden" name="action" value="select"><div class="cms-form-columns">{% for key,label in {body:'Body text / Fließtext',heading:'Headings / Überschriften'} %}<label>{{ label }}<select name="{{ key }}">{% for id,name in builtins %}<option value="{{ id }}"{% if selected[key ~ '_font']==id %} selected{% endif %}>{{ name }}</option>{% endfor %}{% for font in fonts %}<option value="{{ font.id }}"{% if selected[key ~ '_font']==font.id %} selected{% endif %}>{{ font.label }}</option>{% endfor %}</select></label>{% endfor %}</div><p>{{ en ? 'Starter default keeps each design’s own type pairing. Imported fonts are public website assets; upload only fonts you are licensed to use.' : 'Die Vorlagen-Vorgabe erhält die Schriftkombination des Designs. Importierte Schriften sind öffentliche Website-Dateien. Laden Sie nur lizenzierte Schriften hoch.' }}</p><button>{{ en ? 'Save typography' : 'Typografie speichern' }}</button></form><form method="post" enctype="multipart/form-data" class="font-upload"><h2>{{ en ? 'Import a font' : 'Schrift importieren' }}</h2><input type="hidden" name="_token" value="{{ csrf_token('fonts') }}"><input type="hidden" name="action" value="upload"><label>{{ en ? 'Font name' : 'Schriftname' }}<input name="label" required minlength="2" maxlength="80" placeholder="e.g. Practice Sans"></label><label>{{ en ? 'WOFF2 file' : 'WOFF2-Datei' }}<input type="file" name="font" accept=".woff2,font/woff2" required></label><label class="cms-check"><input type="checkbox" name="license" value="yes" required>{{ en ? 'I have the rights to use and serve this font on my website.' : 'Ich bin berechtigt, diese Schrift auf meiner Website zu verwenden und auszuliefern.' }}</label><button>{{ en ? 'Upload font' : 'Schrift hochladen' }}</button><p class="cms-help-note">{{ en ? 'Maximum 2 MB per font, 20 fonts / 20 MB total. Local files only; no remote URL fetching. Font validation is structural, not a complete font sanitizer.' : 'Maximal 2 MB pro Schrift, insgesamt 20 Schriften / 20 MB. Nur lokale Dateien; keine externen URLs. Die Prüfung ist strukturell und ersetzt keinen vollständigen Font-Sanitizer.' }}</p></form><h2>{{ en ? 'Imported fonts' : 'Importierte Schriften' }}</h2><div class="cms-table-scroll"><table class="cms-content-table"><thead><tr><th>{{ en ? 'Name' : 'Name' }}</th><th>Format</th><th>{{ en ? 'Size' : 'Größe' }}</th></tr></thead><tbody>{% for font in fonts %}<tr><td>{{ font.label }}</td><td>WOFF2</td><td>{{ (font.bytes/1024)|round }} KB</td></tr>{% else %}<tr><td colspan="3">{{ en ? 'No imported fonts yet. Built-in fonts are ready to use.' : 'Noch keine importierten Schriften. Die integrierten Schriften sind einsatzbereit.' }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}