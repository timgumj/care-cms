{% extends 'admin/auth_base.html.twig' %}
{% block content %}
<h1>{{ 'Forgot password?'|trans }}</h1>
{% if sent %}<p class="notice success" role="status">{{ 'If an account matches that email, a password reset link will be sent. Check your inbox and spam folder.'|trans }}</p>
{% else %}<p>{{ 'Enter your administrator email to receive a password reset link.'|trans }}</p>
{% if error %}<p class="notice error" role="alert">{{ error|trans }}</p>{% endif %}
<form method="post" action="{{ path('app_forgot_password') }}"><label for="email">{{ 'E-Mail-Adresse'|trans }}</label><input id="email" name="email" type="email" autocomplete="username" maxlength="180" required>
<input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_request') }}"><button class="submit" type="submit">{{ 'Email reset link'|trans }}</button></form>{% endif %}
<p><a href="{{ path('app_login') }}">{{ 'Back to login'|trans }}</a></p>
{% endblock %}
