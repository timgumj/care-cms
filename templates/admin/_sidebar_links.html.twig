{% set en = app.request.locale starts with 'en' %}
{% set route = app.request.attributes.get('_route')|default('') %}
{% set controller = app.request.attributes.get('crudControllerFqcn')|default('') %}
{% set groups = [
{label:en?'Workspace':'Arbeitsbereich',items:[{label:en?'Dashboard':'Übersicht',icon:'workspace',url:path('admin'),active:route=='admin'}, {label:en?'Pages':'Seiten',icon:'file',url:path('admin_content_link',{kind:'pages',action:'index'}),active:controller ends with 'PageCrudController'}, {label:en?'Articles':'Artikel',icon:'edit',url:path('admin_content_link',{kind:'articles',action:'index'}),active:controller ends with 'PostCrudController'}, {label:en?'Media library':'Mediathek',icon:'image',url:path('admin_media'),active:route=='admin_media'}, {label:en?'Trash':'Papierkorb',icon:'delete',url:path('admin_trash'),active:route starts with 'admin_trash'}]},
{label:en?'Practice':'Praxis',admin:true,items:[{label:en?'Calendar & bookings':'Kalender & Termine',icon:'calendar',url:path('admin_calendar'),active:route=='admin_calendar'}]},
{label:en?'Website':'Website',admin:true,items:[{label:en?'Starter packs':'Starter-Vorlagen',icon:'layers',url:path('admin_starters'),active:route starts with 'admin_starter'}, {label:en?'Fonts':'Schriften',icon:'text',url:path('admin_fonts'),active:route=='admin_fonts'}, {label:en?'Navigation menus':'Menüs',icon:'menu',url:path('admin_menus'),active:route=='admin_menus'}, {label:en?'Announcements':'Ankündigungen',icon:'notice',url:path('admin_announcements'),active:route=='admin_announcements'}]},
{label:en?'Administration':'Verwaltung',admin:true,items:[{label:en?'Users':'Benutzer',icon:'users',url:path('admin_users'),active:route starts with 'admin_user'}, {label:en?'Security & sessions':'Sicherheit & Sitzungen',icon:'lock',url:path('admin_session_settings'),active:route=='admin_session_settings'}, {label:en?'Cache':'Cache',icon:'refresh',url:path('admin_cache'),active:route=='admin_cache'}]}
] %}
<nav class="cms-sidebar-nav" aria-label="{{ en ? 'Main administration navigation' : 'Hauptnavigation Verwaltung' }}">{% for group in groups %}{% if not group.admin|default(false) or is_granted('ROLE_ADMIN') %}<div class="cms-sidebar-group"><span class="cms-sidebar-label">{{ group.label }}</span>{% for item in group.items %}<a class="cms-sidebar-link{% if item.active %} is-active{% endif %}" href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{% include 'admin/_icon.html.twig' with {name:item.icon} %}<span>{{ item.label }}</span></a>{% endfor %}</div>{% endif %}{% endfor %}</nav>
<div class="cms-sidebar-bottom"><span class="cms-status-dot" aria-hidden="true"></span>Care CMS <span class="cms-sidebar-demo">DEMO</span></div>