{% extends 'admin/auth_base.html.twig' %}{% block title %}Appearance · Care CMS{% endblock %}{% block content %}{% set en=app.request.locale starts with 'en' %}<h1>{{ en ? 'Appearance' : 'Darstellung' }}</h1><p>{{ en ? 'Choose how visitors open the desktop navigation. Mobile navigation always uses the menu button.' : 'Wählen Sie die Navigation für Desktop-Geräte. Auf Mobilgeräten wird immer die Menütaste verwendet.' }}</p>{% for message in app.flashes('success') %}<p role="status">{{ message }}</p>{% endfor %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('appearance') }}"><label>{{ en ? 'Desktop navigation' : 'Desktop-Navigation' }}<select name="desktop_menu"><option value="inline"{{ mode=='inline' ? ' selected' : '' }}>{{ en ? 'Visible navigation links' : 'Sichtbare Navigationslinks' }}</option><option value="hamburger"{{ mode=='hamburger' ? ' selected' : '' }}>{{ en ? 'Menu button' : 'Menütaste' }}</option></select></label><button>{{ en ? 'Save appearance' : 'Darstellung speichern' }}</button></form>{% endblock %}