{% extends 'admin/auth_base.html.twig' %}{% block title %}{{ site.name }} · Care CMS{% endblock %}{% block content %}{% set en=app.request.locale starts with 'en' %}<section class="starter-admin"><p><a href="{{ path('admin_starters') }}">← {{ en ? 'Starter packs' : 'Starter-Vorlagen' }}</a></p><div class="cms-page-intro"><div><h1>{{ site.name }}</h1><p>{{ en ? 'Edit your content, preview privately, then publish when ready.' : 'Inhalte bearbeiten, privat ansehen und veröffentlichen, wenn alles bereit ist.' }}</p></div><span class="cms-small-label">{{ site.pack_key|capitalize }} / DE + EN</span></div><div class="cms-table-scroll"><table class="cms-content-table"><thead><tr><th>{{ en ? 'Page' : 'Seite' }}</th><th>{{ en ? 'Language' : 'Sprache' }}</th><th>Status</th><th>{{ en ? 'Actions' : 'Aktionen' }}</th></tr></thead><tbody>{% for page in pages %}<tr><td>{{ page.title }}</td><td>{{ page.locale starts with 'en' ? 'EN' : 'DE' }}</td><td>{{ page.published ? (en ? 'Published' : 'Veröffentlicht') : (en ? 'Draft' : 'Entwurf') }}</td><td><a href="{{ path('admin_edit_page',{id:page.id}) }}">{{ en ? 'Edit' : 'Bearbeiten' }}</a> · <a href="{{ path('admin_starter_page_preview',{id:page.id}) }}" target="_blank" rel="noopener noreferrer">{{ en ? 'Preview ↗' : 'Vorschau ↗' }}</a></td></tr>{% endfor %}</tbody></table></div><form method="post" action="{{ path('admin_starters') }}" class="starter-publish"><h2>{{ en ? 'Use as your website' : 'Als Website verwenden' }}</h2><p>{{ en ? 'Publishes these ten pages and uses this design at the main site URLs. Existing content and appointments are kept. You can return to the original demo from Starter packs.' : 'Veröffentlicht diese zehn Seiten und verwendet das Design unter den Haupt-URLs. Bestehende Inhalte und Termine bleiben erhalten. Unter Starter-Vorlagen können Sie zur ursprünglichen Demo zurückkehren.' }}</p><input type="hidden" name="_token" value="{{ csrf_token('starter_packs') }}"><input type="hidden" name="action" value="activate"><input type="hidden" name="id" value="{{ site.id }}"><label class="cms-check"><input type="checkbox" name="confirm" value="yes" required>{{ en ? 'Publish these pages and switch the website to this starter.' : 'Diese Seiten veröffentlichen und die Website auf diese Vorlage umstellen.' }}</label><button>{{ en ? 'Publish starter site' : 'Vorlagen-Website veröffentlichen' }}</button></form><p><a href="{{ path('admin_fonts') }}">{{ en ? 'Change the website fonts →' : 'Website-Schriften ändern →' }}</a> · <a href="{{ path('admin_calendar') }}">{{ en ? 'Set booking availability →' : 'Terminverfügbarkeit festlegen →' }}</a></p></section>{% endblock %}