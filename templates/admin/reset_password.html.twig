{% extends 'admin/auth_base.html.twig' %}
{% block content %}<h1>{{ 'Choose a new password'|trans }}</h1>
{% if not valid %}<p class="notice error" role="alert">{{ 'This reset link is invalid, expired, or has already been used.'|trans }}</p><a href="{{ path('app_forgot_password') }}">{{ 'Request a new reset link'|trans }}</a>
{% else %}<p>{{ 'Use at least 14 characters and at most 72 bytes.'|trans }}</p>
{% if error %}<p class="notice error" role="alert">{{ error|trans }}</p>{% endif %}
<form action="{{ path('app_reset_password') }}" method="post">
<label for="password">{{ 'New password'|trans }}</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="new-password" minlength="14" required><button type="button" class="password-toggle" data-toggle-password aria-controls="password" aria-pressed="false">{{ 'Anzeigen'|trans }}</button></div>
<label for="confirm_password">{{ 'Confirm new password'|trans }}</label><div class="password-field"><input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="14" required><button type="button" class="password-toggle" data-toggle-password aria-controls="confirm_password" aria-pressed="false">{{ 'Anzeigen'|trans }}</button></div>
<input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_submit') }}"><button class="submit" type="submit">{{ 'Save new password'|trans }}</button></form>{% endif %}
<p><a href="{{ path('app_login') }}">{{ 'Back to login'|trans }}</a></p>{% endblock %}
