{% set workspace = app.request.attributes.get('_admin_session_active') and is_granted('ROLE_EDITOR') %}
<!doctype html>
<html lang="{{ app.request.locale }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow">
<title>{% block title %}Care Studio · {{ 'Anmeldung'|trans }}{% endblock %}</title>
<link rel="preload" href="/assets/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/admin-theme.css?v=12"><link rel="stylesheet" href="/assets/admin-auth.css?v=12"><script src="/assets/admin-auth.js?v=3" defer></script><script src="/assets/cms-workspace.js?v=1" defer></script>
{% if workspace %}<link rel="stylesheet" href="/assets/cms-toolbar.css?v=12"><link rel="stylesheet" href="/assets/cms-workspace.css?v=12">{% endif %}{% block extra_head %}{% endblock %}<link rel="stylesheet" href="/assets/hanken.css?v=1"><link rel="stylesheet" href="/assets/mint-theme.css?v=1"></head><body class="studio-auth{% if workspace %} cms-workspace cms-has-toolbar{% endif %}">
{% if workspace %}{% include 'admin/_toolbar.html.twig' with {backend:true} %}{% include 'admin/_sidebar.html.twig' %}<button type="button" class="cms-mobile-sidebar-toggle" data-cms-sidebar-toggle aria-controls="cms-admin-sidebar" aria-expanded="false">{% include 'admin/_icon.html.twig' with {name:'menu'} %}{{ app.request.locale starts with 'en' ? 'Navigation' : 'Navigation' }}</button>{% endif %}
<header class="auth-topbar"><a class="brand" href="/">{% include 'admin/_icon.html.twig' with {name:'workspace'} %}<strong>Care Studio</strong><span>/ {{ 'Verwaltung'|trans }}</span></a>{% include 'admin/_language_switch.html.twig' %}</header>
<div class="auth-main"><main class="auth-card"><div class="auth-eyebrow">{% include 'admin/_icon.html.twig' with {name:'lock'} %}{{ 'Geschützter Arbeitsbereich'|trans }}</div>{% block content %}{% endblock %}</main></div>
<footer class="auth-footer"><span>{{ 'Website-Verwaltung'|trans }}</span><a href="/">{{ 'Zur Website'|trans }}{% include 'admin/_icon.html.twig' with {name:'arrow-up-right'} %}</a></footer>
</body></html>
