{% set images=['consultation','reception','coordinator','doctor','team'] %}<article class="mint-card"><a href="{{ post.path }}" tabindex="-1" aria-hidden="true"><img src="/assets/starters/{{ images[(post.id|default(0)) % 5] }}.webp" width="1280" height="853" alt="" loading="lazy"></a><div class="mint-card-body"><p class="mint-kicker">{{ english ? 'Practice notes' : 'Praxisnotizen' }}</p><h2><a href="{{ post.path }}">{{ post.title }}</a></h2><p>{{ post.description }}</p><p class="mint-note">{{ post.updatedAt|date('d.m.Y') }}</p><a class="pack-button" href="{{ post.path }}">{{ english ? 'Read post' : 'Artikel lesen' }}</a></div></article>