<!doctype html><html lang="{{ app.request.locale starts with 'de' ? 'de' : 'en' }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{% block title %}Care Studio · Demo{% endblock %}</title><link rel="stylesheet" href="/assets/demo.css?v=12"><link rel="stylesheet" href="/assets/starter-packs.css?v=14"><link rel="stylesheet" href="/theme/fonts.css"><link rel="stylesheet" href="/assets/announcements.css?v=12"><script src="/assets/demo.js" defer></script>{% if app.request.attributes.get('_admin_session_active') %}<link rel="stylesheet" href="/assets/cms-toolbar.css?v=12"><script src="/assets/cms-workspace.js?v=1" defer></script>{% endif %}{% block head %}{% endblock %}</head><body class="{{ page.bodyClass|default('') }}{% if app.request.attributes.get('_admin_session_active') %} cms-has-toolbar{% endif %}">{% include 'site/_admin_bar.html.twig' %}{% if not (page.bodyClass|default('') starts with 'pack-practice') %}<div class="demo-banner">Fictional portfolio demo · No real healthcare or appointments · Keine echten Patientendaten</div>{% endif %}{% block header %}{% if header is defined and header %}{{ header|raw }}{% else %}<header class="demo-header"><a class="brand" href="/en/">CARE STUDIO<span>CONTENT & CARE, SIMPLIFIED</span></a><nav><a href="/en/services/">Services</a><a href="/booking/">Booking</a><a href="/manage">CMS dashboard</a>{% if app.request.locale starts with 'en' %}<a href="/">DE</a>{% else %}<a href="/en/">EN</a>{% endif %}</nav></header>{% endif %}{% endblock %}{% for message in app.flashes('success') %}<p class="flash" role="status">{{ message }}</p>{% endfor %}{% block body %}{% endblock %}{% block footer %}{% if page is defined and page.footerHtml and page.bodyClass starts with 'pack-' %}{{ page.footerHtml|raw }}{% else %}<footer class="demo-footer"><strong>Care Studio</strong><p>Independent Symfony CMS demonstration. Fictional content; no medical advice.</p><a href="/api/v1/pages?locale=en-AT">Published content API</a> · <a href="/manage">Manage content</a></footer>{% endif %}{% endblock %}</body></html>