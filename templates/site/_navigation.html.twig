<header class="demo-header"><a class="brand" href="{{ english ? '/en/' : '/' }}">CARE STUDIO<span>{{ english ? 'SPACE FOR YOUR WELLBEING' : 'RAUM FÜR IHR WOHLBEFINDEN' }}</span></a><details class="demo-navigation" open><summary>MENU</summary><nav>{% for item in items %}<a href="{{ item.url }}"{% if item.button %} class="button"{% endif %}{% if item.current %} aria-current="page"{% endif %}{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.title }}</a>{% endfor %}{% for language,url in language_links %}<a href="{{ url }}" lang="{{ language }}">{{ language|upper }}</a>{% endfor %}</nav></details></header>