<main class="pack-practice mint-site"><section class="mint-titlebar"><h1>{{ english ? 'Search the practice' : 'Praxis durchsuchen' }}</h1><p>{{ q }}</p></section><section class="mint-section"><div class="mint-wrap"><form action="/search/" method="get"><input type="hidden" name="lang" value="{{ english ? 'en' : 'de' }}"><label>{{ english ? 'Search words' : 'Suchbegriffe' }}<input type="search" name="q" maxlength="100" value="{{ q }}" required minlength="2"></label> <button>{{ english ? 'Search' : 'Suchen' }}</button></form><div class="mint-steps">{% for post in posts %}<article><h2><a href="{{ post.path }}">{{ post.title }}</a></h2><p>{{ post.description }}</p></article>{% else %}<p>{{ english ? 'No matching published pages. Try another search with at least two letters.' : 'Keine passenden veröffentlichten Seiten. Versuchen Sie einen anderen Begriff mit mindestens zwei Zeichen.' }}</p>{% endfor %}</div></div></section></main>