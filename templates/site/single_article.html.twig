{% set english=page.locale starts with 'en' %}
<main class="pack-site {{ page.bodyClass }} practice-journal"><section class="journal-intro"><img src="/assets/starters/consultation.webp" width="1280" height="853" alt="{{ english ? 'Illustrative fictional consultation' : 'Illustrative fiktive Beratung' }}"><div class="journal-single-heading"><a href="{{ english ? '/en/articles/' : '/artikel/' }}">← {{ english ? 'All articles' : 'Alle Artikel' }}</a><p class="pack-kicker">{{ english ? 'PRACTICE JOURNAL' : 'PRAXIS-JOURNAL' }} · {{ page.updatedAt|date('d.m.Y') }}</p><h1>{{ page.title }}</h1><p>{{ page.description }}</p></div></section><article class="journal-single-content">{{ content|raw }}</article><section class="journal-next-step"><h2>{{ english ? 'Plan your next visit' : 'Planen Sie Ihren nächsten Besuch' }}</h2><p>{{ english ? 'Find a suitable demonstration appointment in the practice calendar.' : 'Finden Sie einen passenden Demonstrationstermin im Praxiskalender.' }}</p><a class="pack-button" href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'VIEW APPOINTMENTS' : 'TERMINE ANSEHEN' }} {% include 'starters/arrow.html.twig' %}</a></section></main>
