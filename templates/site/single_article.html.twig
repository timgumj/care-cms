{% set english=page.locale starts with 'en' %}<main class="pack-site {{ page.bodyClass }} mint-site"><section class="mint-split"><div><p class="mint-kicker">{{ english ? 'Practice journal' : 'Praxis-Journal' }}</p><h1>{{ page.title }}</h1><p>{{ page.description }}</p><p class="mint-note">{{ page.updatedAt|date('d.m.Y') }}</p><a href="{{ english ? '/en/articles/' : '/artikel/' }}">← {{ english ? 'All articles' : 'Alle Artikel' }}</a></div><img src="/assets/starters/consultation.webp" width="1280" height="853" alt="{{ english ? 'Fictional consultation' : 'Fiktive Beratung' }}"></section><article class="mint-reading">{{ content|raw }}</article><section class="mint-related"><div class="mint-wrap"><h2>{{ english ? 'More from the practice' : 'Mehr aus der Praxis' }}</h2><div class="mint-grid">{% for post in related_posts|default([]) %}{% include 'site/post_card.html.twig' %}{% endfor %}</div><p style="margin-top:30px"><a href="{{ english ? '/en/articles/' : '/artikel/' }}">{{ english ? 'Explore the journal' : 'Zum Praxis-Journal' }} {% include 'starters/arrow.html.twig' %}</a></p></div></section>{% include 'starters/rail.html.twig' with {base:'/'} %}</main>