{% extends 'site/base.html.twig' %}{% block title %}{{ page.title }} · Care Studio{% endblock %}{% block head %}<meta name="description" content="{{ page.description }}"><link rel="canonical" href="{{ page.canonical }}">{% for locale,translation in alternates %}<link rel="alternate" hreflang="{{ locale }}" href="{{ translation.canonical }}">{% endfor %}{% endblock %}{% block header %}{{ header|raw }}{% endblock %}{% block body %}{% if page.kind == 'Beitrag' %}{% include 'site/single_article.html.twig' %}{% elseif page.bodyClass starts with 'pack-' and 'pack-site' not in content %}<main class="pack-site {{ page.bodyClass }}">{{ content|raw }}</main>{% else %}{{ content|raw }}{% endif %}{% endblock %}