<main class="pack-site {{ page.bodyClass }} practice-journal">
<section class="journal-intro"><img src="/assets/starters/reception.webp" alt="{{ english ? 'Illustrative fictional practice reception' : 'Illustrativer fiktiver Praxisempfang' }}" width="1280" height="640"><div><p class="pack-kicker">{{ english ? 'FROM THE PRACTICE' : 'AUS DER PRAXIS' }}</p><h1>{{ english ? 'Articles & practice notes' : 'Artikel & Praxisnotizen' }}</h1><p>{{ english ? 'Updates, useful information and a closer look at our fictional practice.' : 'Neuigkeiten, hilfreiche Informationen und Einblicke in unsere fiktive Praxis.' }}</p></div></section>
<section class="journal-list-section"><div class="practice-section-heading"><h2>{{ english ? 'LATEST ARTICLES' : 'AKTUELLE ARTIKEL' }}</h2><span></span></div><div class="journal-grid">{% for post in posts %}<article><a href="{{ post.path }}" tabindex="-1" aria-hidden="true"><img src="/assets/starters/consultation.webp" alt="" width="1280" height="853" loading="lazy"></a><div><p class="journal-date">{{ post.updatedAt|date('d.m.Y') }}</p><h2><a href="{{ post.path }}">{{ post.title }}</a></h2><p>{{ post.description }}</p><a class="pack-button" href="{{ post.path }}">{{ english ? 'READ ARTICLE' : 'ARTIKEL LESEN' }} {% include 'starters/arrow.html.twig' %}</a></div></article>{% else %}<p>{{ english ? 'There are no published articles yet.' : 'Es sind noch keine Artikel veröffentlicht.' }}</p>{% endfor %}</div></section></main>
