<main class="pack-site {{ page.bodyClass }} mint-site"><section class="mint-titlebar"><h1>{{ english ? 'Practice journal' : 'Praxis-Journal' }}</h1><p>{{ english ? 'People, practical information and a closer look at our fictional practice.' : 'Menschen, praktische Informationen und Einblicke in unsere fiktive Praxis.' }}</p></section><section class="mint-section"><div class="mint-wrap"><nav class="mint-filters" aria-label="{{ english ? 'Blog categories' : 'Blog-Kategorien' }}">{% for value,label in {'':(english ? 'All articles' : 'Alle Artikel'),'practice':(english ? 'The practice' : 'Die Praxis'),'planning':(english ? 'Planning a visit' : 'Besuch planen')} %}<a href="?category={{ value }}"{% if app.request.query.get('category','')==value %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav><div class="mint-grid">{% for post in posts %}{% include 'site/post_card.html.twig' %}{% else %}<p>{{ english ? 'No articles in this category yet.' : 'Noch keine Artikel in dieser Kategorie.' }}</p>{% endfor %}</div></div></section>{% include 'starters/rail.html.twig' with {base:'/'} %}</main>