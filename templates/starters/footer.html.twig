{% if key=='practice' %}<footer class="pack-footer pack-practice"><div class="pack-footer-columns"><section><a class="pack-footer-brand" href="{{ base }}{{ english ? 'en/' : '' }}">{{ brand }}</a><p>{{ english ? 'A fictional family practice, thoughtfully connected.' : 'Eine fiktive Familienpraxis. Gemeinsam gut organisiert.' }}</p><p>Musterstraße 12 · 1010 Wien<br><a href="mailto:hello@example.test">hello@example.test</a><br><a href="tel:+4310000000">+43 1 000 0000</a></p><p id="social">{{ english ? 'Portfolio demonstration · No real patient data.' : 'Portfolio-Demonstration · Keine echten Patientendaten.' }}</p></section><section><h2>{{ english ? 'Your practice' : 'Ihre Praxis' }}</h2><nav>{% for path,label in {'services/':(english ? 'Our services' : 'Unsere Leistungen'),'offers/':(english ? 'Practice programmes' : 'Praxisangebote'),'planner/':(english ? 'Calendar & planner' : 'Kalender & Planung'),'contact/':(english ? 'Contact & directions' : 'Kontakt & Anreise')} %}<a href="{{ base }}{{ english ? 'en/' : '' }}{{ path }}">{{ label }}</a>{% endfor %}<a href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'Book an appointment' : 'Termin buchen' }}</a></nav></section><section><h2>{{ english ? 'Good to know' : 'Gut zu wissen' }}</h2><nav><a href="{{ base }}{{ english ? 'en/' : '' }}about/">{{ english ? 'About us' : 'Über uns' }}</a><a href="{{ english ? '/en/articles/' : '/artikel/' }}">Blog</a><a href="{{ base }}{{ english ? 'en/' : '' }}contact/">{{ english ? 'Opening hours' : 'Öffnungszeiten' }}</a></nav><dl class="mint-hours"><dt>{{ english ? 'Monday–Friday' : 'Montag–Freitag' }}</dt><dd>09:00–17:00</dd><dt>{{ english ? 'Weekend' : 'Wochenende' }}</dt><dd>{{ english ? 'Closed' : 'Geschlossen' }}</dd></dl></section></div><details class="mint-certificates"><summary>{{ english ? 'Demo certification placeholders' : 'Demo-Zertifikatsplatzhalter' }}</summary>{% for n in 1..4 %}<img src="/assets/starters/certification-{{ n }}.svg" width="240" height="80" loading="lazy" alt="{{ english ? 'Demo certificate placeholder' : 'Demo-Zertifikatsplatzhalter' }} {{ n }}">{% endfor %}</details><div class="mint-footer-bottom"><nav>{% for path,label in {'privacy/':(english ? 'Privacy policy' : 'Datenschutz'),'terms/':(english ? 'Terms & conditions' : 'Nutzungsbedingungen'),'cookies/':(english ? 'Cookie policy' : 'Cookie-Richtlinie')} %}<a href="/{{ english ? 'en/' : '' }}{{ path }}">{{ label }}</a>{% endfor %}</nav><span>CARE CMS · {{ english ? 'Fictional portfolio demo' : 'Fiktive Portfolio-Demo' }}</span></div></footer>{% else %}<footer class="pack-footer pack-{{ key }}"><div class="pack-footer-columns"><section><a class="pack-footer-brand" href="{{ base }}{{ english ? 'en/' : '' }}">{{ brand }}</a><p>{{ english ? 'General & family practice' : 'Allgemein- & Familienmedizin' }}<br>Musterstraße 12, 1010 Wien</p><p><a href="tel:+4310000000">+43 1 000 0000</a><br><a href="mailto:hello@example.test">hello@example.test</a></p><p id="social">{{ english ? 'Social profiles: add your own links in the editor.' : 'Social-Media-Profile: eigene Links im Editor ergänzen.' }}</p></section><section><h2>{{ english ? 'Opening hours' : 'Öffnungszeiten' }}</h2><dl>{% for day in (english ? ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'] : ['Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag','Sonntag']) %}<dt>{{ day }}</dt><dd>{{ loop.index < 6 ? '09:00 – 17:00' : (english ? 'Closed' : 'Geschlossen') }}</dd>{% endfor %}</dl></section><section><h2>{{ english ? 'Explore' : 'Übersicht' }}</h2><nav aria-label="{{ english ? 'Footer navigation' : 'Fußnavigation' }}">{% for path,label in {'':(english ? 'Home' : 'Startseite'),'about/':(english ? 'About' : 'Über uns'),'services/':(english ? 'Services' : 'Leistungen'),'contact/':(english ? 'Contact' : 'Kontakt'),'planner/':(english ? 'Calendar & planner' : 'Kalender & Planung')} %}<a href="{{ base }}{{ english ? 'en/' : '' }}{{ path }}">{{ label }} {% include 'starters/arrow.html.twig' %}</a>{% endfor %}</nav></section></div><div class="pack-certifications"><h2>{{ english ? 'Certification placeholders — demonstration only' : 'Zertifikatsplatzhalter — nur Demonstration' }}</h2><div>{% for n in 1..4 %}<figure><img src="/assets/starters/certification-{{ n }}.svg" width="240" height="80" alt="{{ english ? 'Demo certificate placeholder' : 'Demo-Zertifikatsplatzhalter' }} {{ n }}"><figcaption>{{ english ? 'Replace with your authorised certificate' : 'Durch autorisiertes Zertifikat ersetzen' }}</figcaption></figure>{% endfor %}</div></div><small>{{ english ? 'Fictional practice, address and certificates. No real medical care. Edit footer details and certificate images in the page editor. Displayed hours must match calendar availability.' : 'Fiktive Praxis, Adresse und Zertifikate. Keine medizinische Versorgung. Fußzeile und Zertifikatsbilder im Seiteneditor bearbeiten. Öffnungszeiten mit Kalender-Verfügbarkeit abstimmen.' }}</small></footer>{% endif %}