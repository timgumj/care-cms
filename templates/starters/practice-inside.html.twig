<main class="pack-site pack-practice practice-inner">
<section class="practice-split-intro">
<figure><img src="/assets/starters/{{ section=='about' ? 'doctor' : (section=='contact' ? 'coordinator' : (section=='planner' ? 'consultation' : 'reception')) }}.webp" width="1280" height="853" fetchpriority="high" alt="{{ english ? 'Original generated image of a fictional medical practice' : 'Original generiertes Bild einer fiktiven Arztpraxis' }}"></figure>
<div class="practice-intro-copy"><p class="pack-kicker">{{ brand }}</p><h1>{{ section=='about' ? (english ? 'About our practice' : 'Über unsere Praxis') : (section=='services' ? (english ? 'Care, clearly explained' : 'Leistungen, klar erklärt') : (section=='contact' ? (english ? 'Contact our team' : 'Kontakt zu unserem Team') : (english ? 'Your next appointment' : 'Ihr nächster Termin'))) }}</h1>
{% if section=='about' %}<h2>{{ english ? 'People first. Every visit.' : 'Der Mensch im Mittelpunkt.' }}</h2><p>{{ english ? 'Praxis Morgen is a fictional family practice built around a simple idea: good conversations make visits easier. A familiar team, clear information and considered next steps help you feel prepared.' : 'Praxis Morgen ist eine fiktive Familienpraxis mit einer einfachen Idee: Gute Gespräche machen den Praxisbesuch leichter. Ein vertrautes Team, klare Informationen und gemeinsam besprochene nächste Schritte geben Orientierung.' }}</p><p>{{ english ? 'We make space for questions and explain how appointments work before you arrive. Meet the people and the approach behind this demonstration practice.' : 'Wir schaffen Raum für Fragen und erklären den Ablauf bereits vor Ihrem Besuch. Lernen Sie die Menschen und den Ansatz dieser Demonstrationspraxis kennen.' }}</p><a class="pack-button" href="#practice-team">{{ english ? 'MEET THE TEAM' : 'UNSER TEAM' }} {% include 'starters/arrow.html.twig' %}</a>
{% elseif section=='contact' %}<p>{{ english ? 'For general information or to plan a visit, our fictional reception team is here to help.' : 'Für allgemeine Informationen und die Planung Ihres Besuchs ist unser fiktives Empfangsteam gerne da.' }}</p><div class="practice-contact-details"><div><h2>{{ english ? 'Telephone' : 'Telefon' }}</h2><a href="tel:+4310000000">+43 1 000 0000</a></div><div><h2>{{ english ? 'Address' : 'Adresse' }}</h2><p>Musterstraße 12<br>1010 Wien · {{ english ? 'Demo address' : 'Demo-Adresse' }}</p></div><div><h2>{{ english ? 'Appointments' : 'Termine' }}</h2><a href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'Book online' : 'Online buchen' }} {% include 'starters/arrow.html.twig' %}</a></div><div><h2>E-mail</h2><a href="mailto:hello@example.test">hello@example.test</a></div></div>{% include 'starters/practice-hours.html.twig' %}
{% elseif section=='services' %}<p>{{ english ? 'From a first conversation to a planned follow-up: find the right appointment and know what to expect.' : 'Vom ersten Gespräch bis zum geplanten Folgetermin: Finden Sie den passenden Termin und erfahren Sie, was Sie erwartet.' }}</p><p>{{ english ? 'Our demo shows how a practice can present its services clearly. These examples are fictional and do not constitute medical care.' : 'Unsere Demo zeigt, wie eine Praxis ihre Leistungen verständlich präsentieren kann. Diese Beispiele sind fiktiv und stellen keine medizinische Versorgung dar.' }}</p><a class="pack-button" href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'FIND AN APPOINTMENT' : 'TERMIN FINDEN' }} {% include 'starters/arrow.html.twig' %}</a>
{% else %}<p>{{ english ? 'A few simple steps, a time that suits you. Choose a consultation or follow-up and see the available appointments in our calendar.' : 'Wenige Schritte, ein passender Zeitpunkt. Wählen Sie Beratung oder Folgetermin und sehen Sie die verfügbaren Termine in unserem Kalender.' }}</p><a class="pack-button" href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'OPEN BOOKING CALENDAR' : 'BUCHUNGSKALENDER ÖFFNEN' }} {% include 'starters/arrow.html.twig' %}</a><p>{{ english ? 'Demonstration only. Please do not enter medical information.' : 'Nur Demonstration. Bitte keine medizinischen Informationen eingeben.' }}</p>{% endif %}</div></section>
{% if section=='about' %}
<section class="practice-story"><div class="practice-section-heading"><h2>{{ english ? 'OUR APPROACH' : 'UNSER ANSATZ' }}</h2><span></span></div><div class="practice-story-grid"><div><p class="pack-kicker">{{ english ? 'A FAMILIAR PLACE' : 'EIN VERTRAUTER ORT' }}</p><h2>{{ english ? 'Clear care starts with listening.' : 'Gute Begleitung beginnt mit Zuhören.' }}</h2></div><div class="practice-values">{% for title,copy in (english ? {'Before your visit':'Choose a suitable appointment online and receive a clear confirmation.','At the practice':'A welcoming reception and enough time to explain your questions.','After your appointment':'Keep the next steps clear and arrange a follow-up when needed.'} : {'Vor Ihrem Besuch':'Wählen Sie online einen passenden Termin und erhalten Sie eine klare Bestätigung.','In der Praxis':'Ein freundlicher Empfang und Zeit, um Ihre Fragen zu besprechen.','Nach Ihrem Termin':'Behalten Sie die nächsten Schritte im Blick und planen Sie bei Bedarf einen Folgetermin.'}) %}<article><h3>{{ title }}</h3><p>{{ copy }}</p></article>{% endfor %}</div></div></section>
<section id="practice-team"><div class="practice-section-heading"><h2>{{ english ? 'MEET OUR TEAM' : 'UNSER TEAM' }}</h2><span></span></div><div class="practice-team-grid">{% for member in [['doctor',english ? 'Your practitioner' : 'Ihre Ärztin',english ? 'Personal consultations' : 'Persönliche Beratung'],['coordinator',english ? 'Your reception team' : 'Ihr Empfangsteam',english ? 'Appointments & organisation' : 'Termine & Organisation'],['team',english ? 'Working together' : 'Gemeinsam für Sie da',english ? 'A coordinated practice team' : 'Ein eingespieltes Praxisteam']] %}{% set image=member[0] %}{% set title=member[1] %}{% set role=member[2] %}<article><img src="/assets/starters/{{ image }}.webp" width="1280" height="853" alt="{{ english ? 'Fictional demonstration team' : 'Fiktives Demonstrationsteam' }}" loading="lazy"><div><h3>{{ title }}</h3><p>{{ role }}</p></div></article>{% endfor %}</div><p class="practice-demo-note">{{ english ? 'All people shown are generated fictional characters, not registered clinicians or staff.' : 'Alle abgebildeten Personen sind generierte fiktive Charaktere, keine echten Ärztinnen, Ärzte oder Mitarbeitenden.' }}</p></section>
{% elseif section=='services' %}<section><div class="practice-section-heading"><h2>{{ english ? 'OUR SERVICES' : 'UNSERE LEISTUNGEN' }}</h2><span></span></div><div class="practice-detailed-services">{% for title,copy in (english ? {'First consultation':'A 30-minute demonstration appointment with time to explain your questions and discuss next steps.','Follow-up appointment':'A focused 15-minute demonstration visit to continue an earlier conversation.','Preventive visits':'Use this space to explain the routine services offered by your own practice.','Planning your visit':'Choose a date in the calendar, receive confirmation and bring relevant documents with you.','Individual information':'Present your actual services, qualifications and appointment guidance clearly.','A familiar team':'Patients can find contact information and practice hours in one consistent place.'} : {'Erstgespräch':'Ein 30-minütiger Demonstrationstermin mit Zeit für Ihre Fragen und die nächsten Schritte.','Folgetermin':'Ein gezielter 15-minütiger Demonstrationstermin, um ein früheres Gespräch fortzusetzen.','Vorsorgetermine':'Hier können Sie die regulären Leistungen Ihrer eigenen Praxis verständlich erklären.','Besuch planen':'Wählen Sie ein Datum im Kalender, erhalten Sie eine Bestätigung und bringen Sie relevante Unterlagen mit.','Individuelle Informationen':'Stellen Sie Ihre tatsächlichen Leistungen, Qualifikationen und Terminhinweise klar vor.','Ein vertrautes Team':'Kontaktmöglichkeiten und Öffnungszeiten sind an einem einheitlichen Ort zu finden.'}) %}<article><h2>{{ title }}</h2><p>{{ copy }}</p><a class="pack-button" href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'BOOK A VISIT' : 'TERMIN BUCHEN' }} {% include 'starters/arrow.html.twig' %}</a></article>{% endfor %}</div></section><section class="practice-image-feature"><img src="/assets/starters/consultation.webp" width="1280" height="853" alt="{{ english ? 'Fictional consultation scene' : 'Fiktive Beratungsszene' }}" loading="lazy"><div><h2>{{ english ? 'Time for a conversation.' : 'Zeit für ein Gespräch.' }}</h2><p>{{ english ? 'A good visit begins with clear expectations. Our calendar makes it easy to choose a suitable demonstration appointment.' : 'Ein guter Besuch beginnt mit klaren Erwartungen. Unser Kalender macht es einfach, einen passenden Demonstrationstermin auszuwählen.' }}</p><a class="pack-button" href="{{ base }}{{ english ? 'en/' : '' }}planner/">{{ english ? 'VIEW THE CALENDAR' : 'ZUM KALENDER' }} {% include 'starters/arrow.html.twig' %}</a></div></section>
{% elseif section=='contact' %}<section class="practice-image-feature" id="social"><img src="/assets/starters/reception.webp" width="1280" height="640" alt="{{ english ? 'Fictional practice reception' : 'Fiktiver Praxisempfang' }}" loading="lazy"><div><h2>{{ english ? 'A welcoming place to arrive.' : 'Ein freundlicher Ort zum Ankommen.' }}</h2><p>{{ english ? 'Please arrive a few minutes before your demonstration appointment. This address and contact information are examples; no real healthcare is provided here.' : 'Kommen Sie einige Minuten vor Ihrem Demonstrationstermin. Adresse und Kontaktdaten sind Beispiele. Hier findet keine echte medizinische Versorgung statt.' }}</p><p>{{ english ? 'Social links in this demo lead here. Replace them with your own profiles when setting up your site.' : 'Die Social-Media-Links dieser Demo führen hierher. Ersetzen Sie sie bei der Einrichtung durch Ihre eigenen Profile.' }}</p><a class="pack-button" href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'PLAN YOUR VISIT' : 'BESUCH PLANEN' }} {% include 'starters/arrow.html.twig' %}</a></div></section>
{% else %}<section class="practice-planner-steps"><div class="practice-section-heading"><h2>{{ english ? 'HOW IT WORKS' : 'SO FUNKTIONIERT ES' }}</h2><span></span></div><div class="practice-visit-grid"><article><h2>{{ english ? 'Choose a visit' : 'Terminart wählen' }}</h2><p>{{ english ? 'Consultation: 30 minutes. Follow-up: 15 minutes.' : 'Beratung: 30 Minuten. Folgetermin: 15 Minuten.' }}</p></article><article><h2>{{ english ? 'Find a time' : 'Zeitpunkt finden' }}</h2><p>{{ english ? 'Available slots are controlled by the practice calendar.' : 'Die verfügbaren Zeiten werden im Praxiskalender verwaltet.' }}</p></article><article><h2>{{ english ? 'Receive confirmation' : 'Bestätigung erhalten' }}</h2><p>{{ english ? 'Your email includes the appointment and a cancellation link.' : 'Ihre E-Mail enthält den Termin und einen Link zur Absage.' }}</p></article></div></section>{% endif %}
</main>
