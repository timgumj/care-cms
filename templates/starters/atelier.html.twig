<main class="pack-site pack-atelier">
<section class="atelier-hero hero"><div class="atelier-hero-photo"><img src="/assets/starters/team.webp" alt="{{ english ? 'Illustrative fictional practice team' : 'Illustratives fiktives Praxisteam' }}" width="1280" height="853" fetchpriority="high"></div><div class="atelier-hero-brand"><span class="atelier-emblem" aria-hidden="true">{{ brand|slice(0,1) }}</span><p>{{ brand }}</p><small>{{ english ? 'A practice for every generation.' : 'Eine Praxis für jede Generation.' }}</small></div></section>
<section class="pack-introduction"><div><p class="pack-kicker">{{ english ? 'WELCOME TO OUR PRACTICE' : 'WILLKOMMEN IN UNSERER PRAXIS' }}</p><h1>{{ english ? 'Good medicine begins with listening.' : 'Gute Medizin beginnt mit Zuhören.' }}</h1></div><div><h2>{{ english ? 'A familiar team. Time for your questions.' : 'Ein vertrautes Team. Zeit für Ihre Fragen.' }}</h2><p>{{ english ? 'Our fictional practice brings general and family medicine together. This starter gives your team a clear place for information, services and appointments.' : 'Unsere fiktive Praxis verbindet Allgemein- und Familienmedizin. Diese Vorlage bietet Ihrem Team einen klaren Ort für Informationen, Leistungen und Termine.' }}</p><a class="pack-text-link" href="{{ base }}{{ english ? 'en/' : '' }}about/">{{ english ? 'Meet the practice →' : 'Unsere Praxis kennenlernen →' }}</a></div></section>
{% include 'starters/news.html.twig' %}
<section class="atelier-services"><p class="pack-kicker">{{ english ? 'OUR SERVICES' : 'UNSERE LEISTUNGEN' }}</p><h2>{{ english ? 'Here for your everyday health.' : 'Für Ihre Gesundheit im Alltag.' }}</h2><div class="pack-service-pair"><article><img src="/assets/starters/doctor.webp" alt="{{ english ? 'Illustrative practitioner in a consultation room' : 'Illustrative Ärztin im Sprechzimmer' }}" loading="lazy" width="1280" height="853"><div><h3>{{ english ? 'General practice' : 'Allgemeinmedizin' }}</h3><p>{{ english ? 'Consultations, prevention and clear next steps.' : 'Beratung, Vorsorge und klare nächste Schritte.' }}</p><a class="pack-button" href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'Choose a time' : 'Termin wählen' }}</a></div></article><article><img src="/assets/starters/reception.webp" alt="{{ english ? 'Fictional practice reception' : 'Fiktiver Praxisempfang' }}" loading="lazy" width="1280" height="640"><div><h3>{{ english ? 'Follow-up appointments' : 'Folgetermine' }}</h3><p>{{ english ? 'A familiar point of contact for your questions.' : 'Eine vertraute Anlaufstelle für Ihre Fragen.' }}</p><a class="pack-button" href="/booking/?type=follow-up&lang={{ english ? 'en' : 'de' }}">{{ english ? 'View availability' : 'Verfügbarkeit ansehen' }}</a></div></article></div></section>
{% include 'starters/team.html.twig' %}{% include 'starters/contact.html.twig' %}</main>