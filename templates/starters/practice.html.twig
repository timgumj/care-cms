<main class="pack-site pack-practice">
<section class="practice-hero"><img src="/assets/starters/team.webp" width="1280" height="640" alt="{{ english ? 'Fictional practice team in a bright consultation room' : 'Fiktives Praxisteam in einem hellen Behandlungsraum' }}" fetchpriority="high"><div class="practice-welcome"><div><h1>{{ brand }}</h1><p class="pack-kicker">{{ english ? 'WELCOME TO OUR PRACTICE' : 'WILLKOMMEN IN UNSERER PRAXIS' }}</p><p>{{ english ? 'Time to listen. Space for your questions. Our fictional family practice brings clear advice, thoughtful planning and a familiar team together in one welcoming place.' : 'Zeit zum Zuhören. Raum für Ihre Fragen. Unsere fiktive Familienpraxis verbindet verständliche Beratung, sorgfältige Planung und ein vertrautes Team an einem freundlichen Ort.' }}</p><a class="pack-button" href="{{ base }}{{ english ? 'en/' : '' }}services/">{{ english ? 'OUR SERVICES' : 'UNSERE LEISTUNGEN' }} {% include 'starters/arrow.html.twig' %}</a></div></div></section>
<section class="practice-services"><div class="practice-section-heading"><h2>{{ english ? 'OUR SERVICES' : 'UNSERE LEISTUNGEN' }}</h2><span></span></div><div class="practice-service-grid">{% for title,copy in (english ? {'Personal consultation':'A considered first conversation, with time for your questions and next steps.','Preventive visits':'Plan a routine visit and discuss the information relevant to your wellbeing.','Follow-up appointments':'Continue a conversation with the team and organise your next visit.'} : {'Persönliche Beratung':'Ein sorgfältiges Erstgespräch mit Zeit für Ihre Fragen und die nächsten Schritte.','Vorsorgetermine':'Planen Sie einen regulären Besuch und besprechen Sie Ihre Anliegen.','Folgetermine':'Setzen Sie das Gespräch mit dem Team fort und organisieren Sie Ihren nächsten Besuch.'}) %}<article><img src="/assets/starters/{{ loop.index==1 ? 'consultation' : (loop.index==2 ? 'doctor' : 'reception') }}.webp" width="1280" height="853" loading="lazy" alt="{{ english ? 'Illustrative fictional practice service' : 'Illustrative fiktive Praxisleistung' }}"><div><h3>{{ title }}</h3><p>{{ copy }}</p></div></article>{% endfor %}</div><a class="pack-button" href="{{ base }}{{ english ? 'en/' : '' }}services/">{{ english ? 'ALL SERVICES' : 'ALLE LEISTUNGEN' }} {% include 'starters/arrow.html.twig' %}</a></section>
<section class="practice-visit"><div class="practice-section-heading"><h2>{{ english ? 'CONTACT THE PRACTICE' : 'KONTAKT ZUR PRAXIS' }}</h2><span></span></div><p>{{ english ? 'Find a suitable appointment or get in touch for general practice information. This is a portfolio demonstration, not a medical service.' : 'Finden Sie einen passenden Termin oder kontaktieren Sie uns für allgemeine Praxisinformationen. Dies ist eine Portfolio-Demonstration, kein medizinisches Angebot.' }}</p><div class="practice-visit-grid"><article><h3>{{ english ? 'Your visit' : 'Ihr Besuch' }}</h3><p>{{ brand }}<br>Musterstraße 12<br>1010 Wien · {{ english ? 'Fictional address' : 'Fiktive Adresse' }}</p><a href="tel:+4310000000">+43 1 000 0000</a><br><a href="mailto:hello@example.test">hello@example.test</a><p><a class="pack-button" href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'BOOK ONLINE' : 'ONLINE TERMIN BUCHEN' }} {% include 'starters/arrow.html.twig' %}</a></p></article><article><h3>{{ english ? 'We are here for you' : 'Wir sind für Sie da' }}</h3><p>{{ english ? 'Monday to Friday' : 'Montag bis Freitag' }}<br>09:00 – 17:00<br>{{ english ? 'Saturday and Sunday: closed' : 'Samstag und Sonntag: geschlossen' }}</p><p>{{ english ? 'Choose consultation or follow-up in our booking calendar.' : 'Wählen Sie Beratung oder Folgetermin in unserem Buchungskalender.' }}</p></article><article><h3>{{ english ? 'Before your appointment' : 'Vor Ihrem Termin' }}</h3><p>{{ english ? 'Please arrive a few minutes early. You can cancel a demo reservation through the link in your confirmation email.' : 'Kommen Sie einige Minuten früher. Eine Demo-Reservierung können Sie über den Link in Ihrer Bestätigungs-E-Mail absagen.' }}</p><a href="{{ base }}{{ english ? 'en/' : '' }}planner/">{{ english ? 'Calendar & planning' : 'Kalender & Planung' }} {% include 'starters/arrow.html.twig' %}</a></article></div></section>
<aside class="practice-contact-rail" aria-label="{{ english ? 'Quick contact' : 'Schnellkontakt' }}"><a href="/booking/?lang={{ english ? 'en' : 'de' }}" aria-label="{{ english ? 'Book an appointment' : 'Termin buchen' }}"><svg class="pack-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="5" width="16" height="16"/><path d="M4 10h16M8 2v6m8-6v6M8 14h3m2 0h3m-8 3h3"/></svg></a><a href="tel:+4310000000" aria-label="{{ english ? 'Call the practice' : 'Praxis anrufen' }}"><svg class="pack-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 3h4l2 5-3 2a15 15 0 0 0 6 6l2-3 5 2v4c0 2-2 3-4 2C9 19 5 15 3 7c-1-2 0-4 2-4Z"/></svg></a><a href="{{ base }}{{ english ? 'en/' : '' }}contact/" aria-label="{{ english ? 'Contact details' : 'Kontaktdaten' }}"><svg class="pack-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><path d="m3 6 9 7 9-7"/></svg></a></aside>
</main>