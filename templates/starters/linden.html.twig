<main class="pack-site pack-linden">
<section class="linden-hero hero"><img src="/assets/starters/reception.webp" alt="{{ english ? 'Illustrative bright family-practice reception' : 'Illustrativer heller Praxisempfang' }}" width="1280" height="640" fetchpriority="high"><div class="linden-hours"><h2>{{ english ? 'Opening hours' : 'Ordinationszeiten' }}</h2><dl><dt>{{ english ? 'Monday' : 'Montag' }}</dt><dd>09:00 – 17:00</dd><dt>{{ english ? 'Tuesday' : 'Dienstag' }}</dt><dd>09:00 – 17:00</dd><dt>{{ english ? 'Wednesday' : 'Mittwoch' }}</dt><dd>09:00 – 17:00</dd><dt>{{ english ? 'Thursday' : 'Donnerstag' }}</dt><dd>09:00 – 17:00</dd><dt>{{ english ? 'Friday' : 'Freitag' }}</dt><dd>09:00 – 17:00</dd></dl><a href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'Choose an appointment →' : 'Termin auswählen →' }}</a></div></section>
<section class="linden-intro"><p class="pack-kicker">{{ english ? 'A PRACTICE FOR YOUR FAMILY' : 'EINE PRAXIS FÜR IHRE FAMILIE' }}</p><h1>{{ english ? 'Welcome. Take your time.' : 'Willkommen. Nehmen Sie sich Zeit.' }}</h1><p>{{ english ? 'A personal, welcoming place for general and family medicine. This is a fictional practice starter, ready for your own team, content and photographs.' : 'Ein persönlicher, freundlicher Ort für Allgemein- und Familienmedizin. Diese fiktive Praxis-Vorlage ist bereit für Ihr Team, Ihre Inhalte und Ihre Fotos.' }}</p></section>
{% include 'starters/news.html.twig' %}{% include 'starters/team.html.twig' %}
<section class="linden-patient"><figure><img src="/assets/starters/reception.webp" alt="{{ english ? 'Illustrative waiting area' : 'Illustrativer Wartebereich' }}" loading="lazy" width="1280" height="640"></figure><div><p class="pack-kicker">{{ english ? 'PATIENT INFORMATION' : 'PATIENTENINFORMATIONEN' }}</p><h2>{{ english ? 'For your visit.' : 'Für Ihren Besuch.' }}</h2><details><summary>{{ english ? 'Making an appointment' : 'Terminvereinbarung' }}</summary><p>{{ english ? 'Use the integrated online calendar to select a free time.' : 'Nutzen Sie den integrierten Online-Kalender zur Terminauswahl.' }}</p><a href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'Open booking' : 'Zur Terminbuchung' }}</a></details><details><summary>{{ english ? 'What to bring' : 'Was Sie mitbringen sollten' }}</summary><p>{{ english ? 'Edit this section with the information relevant to your practice.' : 'Ergänzen Sie hier die für Ihre Praxis wichtigen Informationen.' }}</p></details><details><summary>{{ english ? 'Cancelling an appointment' : 'Termin absagen' }}</summary><p>{{ english ? 'The confirmation email contains a cancellation link.' : 'Die Bestätigungsmail enthält einen Link zur Stornierung.' }}</p></details></div></section>
