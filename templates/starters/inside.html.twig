<main class="pack-site pack-{{ key }} pack-inside"><section><p class="pack-kicker">{{ brand }}</p><h1>{{ section=='about' ? (english ? 'About the practice.' : 'Über die Praxis.') : (section=='services' ? (english ? 'Our services.' : 'Unsere Leistungen.') : (section=='planner' ? (english ? 'Calendar & appointments.' : 'Kalender & Termine.') : (english ? 'Contact & opening hours.' : 'Kontakt & Öffnungszeiten.'))) }}</h1><p>{% if key=='practice' %}{{ english ? 'A welcoming practice, clear information and time for your questions. Discover our fictional team, services and appointment options.' : 'Eine freundliche Praxis, klare Informationen und Zeit für Ihre Fragen. Lernen Sie unser fiktives Team, unsere Leistungen und Terminmöglichkeiten kennen.' }}{% else %}{{ english ? 'Make this page your own in the visual editor. All text and images are replaceable.' : 'Gestalten Sie diese Seite im visuellen Editor. Alle Texte und Bilder lassen sich ersetzen.' }}{% endif %}</p></section>{% if section=='about' %}{% include 'starters/team.html.twig' %}{% elseif section=='services' %}{% include 'starters/services.html.twig' %}{% elseif section=='planner' %}<section class="pack-planner"><div><h2>{{ english ? 'Plan your next visit' : 'Planen Sie Ihren nächsten Besuch' }}</h2><p>{{ english ? 'Choose a consultation or follow-up, see available dates and reserve a time. Availability is managed by the practice in the CMS calendar.' : 'Wählen Sie Beratung oder Folgetermin, sehen Sie freie Termine und reservieren Sie eine Uhrzeit. Die Praxis verwaltet die Verfügbarkeit im CMS-Kalender.' }}</p><a class="pack-button" href="/booking/?lang={{ english ? 'en' : 'de' }}">{{ english ? 'Open booking calendar' : 'Buchungskalender öffnen' }} {% include 'starters/arrow.html.twig' %}</a></div><aside><h3>{{ english ? 'Before you book' : 'Vor Ihrer Buchung' }}</h3><p>{{ english ? 'Consultation: 30 minutes. Follow-up: 15 minutes. This is a fictional demonstration; do not enter medical details.' : 'Beratung: 30 Minuten. Folgetermin: 15 Minuten. Dies ist eine fiktive Demonstration. Bitte keine medizinischen Angaben eingeben.' }}</p></aside></section>{% else %}{% include 'starters/contact.html.twig' %}{% endif %}</main>