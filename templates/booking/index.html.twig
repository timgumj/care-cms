{% extends 'site/base.html.twig' %}{% block title %}{{ english ? 'Book a demo appointment' : 'Demo-Termin buchen' }}{% endblock %}{% block body %}<main{% if page is defined and page.bodyClass starts with 'pack-' %} class="pack-site {{ page.bodyClass }}"{% endif %}><section><p class="eyebrow">{{ timezone }} · DEMO ONLY</p><h1>{{ english ? 'Find a little time for you.' : 'Zeit für Sie.' }}</h1><p>{{ english ? 'Try the appointment flow using fictional details. This does not book medical care.' : 'Testen Sie die Terminbuchung mit erfundenen Daten. Keine echte medizinische Leistung.' }}</p><a href="?lang={{ english ? 'de' : 'en' }}">{{ english ? 'Deutsch' : 'English' }}</a>{% if error %}<p role="alert" class="flash">{{ error }}</p>{% endif %}<form method="get" class="booking-filters"><input type="hidden" name="lang" value="{{ english ? 'en' : 'de' }}"><label>{{ english ? 'Appointment type' : 'Terminart' }}<select name="type">{% for key,item in types %}<option value="{{ key }}"{% if type==key %} selected{% endif %}>{{ item.label }} · {{ item.minutes }} min</option>{% endfor %}</select></label><label>{{ english ? 'Date' : 'Datum' }}<input type="date" name="date" value="{{ date }}" required></label><button type="submit">{{ english ? 'Check availability' : 'Verfügbarkeit prüfen' }}</button></form><form method="post" class="booking-form"><input type="hidden" name="_token" value="{{ csrf_token('booking') }}"><input type="hidden" name="date" value="{{ date }}"><input type="hidden" name="type" value="{{ type }}"><fieldset><legend>{{ english ? 'Available times' : 'Freie Termine' }}</legend><div class="slots">{% for slot in slots %}<label><input type="radio" name="slot" value="{{ slot.timestamp }}" required>{{ slot.label }}</label>{% else %}<p>{{ english ? 'No appointments available. Choose another date.' : 'Keine Termine verfügbar. Bitte anderes Datum wählen.' }}</p>{% endfor %}</div></fieldset><label>{{ english ? 'Demo name' : 'Demo-Name' }}<input name="name" minlength="2" maxlength="100" required autocomplete="off" placeholder="Alex Example"></label><label>{{ english ? 'Demo email' : 'Demo-E-Mail' }}<input type="email" name="email" maxlength="180" required autocomplete="off" placeholder="alex@example.test"></label><label class="check"><input type="checkbox" name="consent" value="yes" required>{{ english ? 'I understand this is a fictional demo. I will not submit medical or patient information.' : 'Ich verstehe, dass dies eine Demo ist, und gebe keine medizinischen oder Patientendaten ein.' }}</label><button type="submit"{% if slots is empty %} disabled{% endif %}>{{ english ? 'Confirm demo appointment' : 'Demo-Termin bestätigen' }}</button></form></section></main>{% endblock %}